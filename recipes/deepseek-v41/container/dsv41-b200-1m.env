# Settings for compose.yaml on one 8x B200 node with 1 TiB of host RAM, at 1M
# context. Also the image's default: `pd` with no launch flags (docker run IMAGE,
# or an env file whose DSV41_LAUNCH_ARGS is empty) runs this file's flags, GPUS
# and ports (entrypoint.sh; DSV41_PROFILE names another container/*.env).
#   docker compose -f compose.yaml --env-file dsv41-b200-1m.env up --no-deps pd
# Start dsv41-engram-cache.service first: it pins the one shared copy of the
# Engram tables (~198 GiB) that both pairs map.
# UNQUALIFIED: no B200 run has gone past 262K context (2026-11-09), and HiCache
# has not been booted with this recipe on B200 since the 131K runs of 2026-10-18.
# Values run to the end of the line; no shell expansion.

DSV41_IMAGE=dsv41-pd:latest
DSV41_MODEL=/data/DeepSeek-V4.1-Flash
DSV41_DATA=/data/dsv41-bringup

# Two pairs in one container: TP2 prefill workers and TP2 decode workers across
# all eight GPUs, behind one router on 8040. With two prefill workers the router
# places conversations by X-SMG-Routing-Key (manual policy), as the B300 files do,
# so a conversation keeps its prefix cache; clients should send one per conversation.
GPUS=0,1,2,3,4,5,6,7
PORT=8040
BOOTSTRAP_PORT=8999
NCCL_PORT=29600
ROUTER_METRICS_PORT=29001

# dsv41-262k.env's flags (B200, measured at 262K) with these changes:
# --context-length 1048576. Prefill pool stays 1048576 tokens (the B200 pool
#   that ran 262K clean; 1.5M OOMed there) with 8K chunks, so a 1M-token prompt
#   fills the whole prefill pool, and other conversations' prefixes live in HiCache.
# --num-prefill 2 --num-decode 2 for eight GPUs.
# --prefill-hicache-ratio auto: sized from host RAM at launch, split across the
#   two prefill workers, capped at 8 (~75 GiB per worker on this pool). On 1 TiB
#   with the Engram holder running, auto reaches the cap.
# Router admission doubled for two pairs (384 in flight, 512 queued; unmeasured).
# Both roles wait up to 20 min for a KV handoff (default 5), as in the B300 1M
# files: a 1M request queued behind other cold 1M prefills can exceed 300 s.
DSV41_LAUNCH_ARGS=--gpu-models B200 --num-prefill 2 --num-decode 2 --context-length 1048576 --chunk-size 8192 --prefill-requests 16 --prefill-schedule-policy hrrn --decode-requests 128 --decode-graph-extra-bs 10,12,14 --decode-polling-interval 2 --tokenizer-workers 4 --prefill-swa-prefix-tails 256 --max-total-tokens 1048576 --prefill-hicache-ratio auto --decode-max-total-tokens 4194304 --mem-fraction 0.92 --custom-all-reduce on --prefill-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --prefill-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --prefill-env NCCL_PROTO=LL128 --prefill-env SGLANG_ENABLE_DISAGG_PREFILL_EARLY_RESULT=1 --prefill-env SGLANG_HRRN_SIZE_EXPONENT=1.5 --prefill-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --decode-env SGLANG_OPT_DSV41_ENGRAM_STAGING_PREFETCH=1 --decode-env SGLANG_DSV41_ENGRAM_GATHER_THREADS=8 --decode-env SGLANG_OPT_PREFIX_PROMPT_ENCODE=1 --prefill-graph-max-seq-len 65536 --compact-host-memory --kernel-cache-dir /data/dsv41-bringup/container-cache/dsv41-pd-latest --decode-radix-cache --router-max-concurrent-requests 384 --router-queue-size 512 --router-queue-timeout-secs 30 --prefill-env SGLANG_DISAGGREGATION_WAITING_TIMEOUT=1200 --decode-env SGLANG_DISAGGREGATION_WAITING_TIMEOUT=1200
DSV41_EXTRA_ARGS=
